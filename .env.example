# Runtime
CODESENTINEL_ENV=development
CODESENTINEL_LOG_LEVEL=INFO
CODESENTINEL_CONFIG_DIR=./config
CODESENTINEL_WORKSPACE_ROOT=./workspaces
CODESENTINEL_ARTIFACT_ROOT=./artifacts

# Persistence
DATABASE_URL=postgresql+asyncpg://codesentinel:change-me@postgres:5432/codesentinel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=codesentinel:reviews

# Model gateway — provide secrets through your deployment environment
MODEL_PROVIDER=openai-compatible
MODEL_NAME=your-model-name
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_TOTAL_TOKEN_BUDGET=160000

# Review execution
REVIEW_PARALLELISM=6
REVIEW_AGENT_TIMEOUT_SECONDS=300
REVIEW_MIN_CONFIDENCE=0.70
REVIEW_FAIL_FAST=false
REVIEW_MAX_FILES=500
REVIEW_MAX_DIFF_LINES=20000

# Repair execution
REPAIR_ENABLED=true
REPAIR_MAX_CONCURRENCY=1
REPAIR_SANDBOX=docker
REPAIR_VALIDATION_TIMEOUT_SECONDS=900
REPAIR_NETWORK_ENABLED=false

# Observability
OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_REDACT_SOURCE=true
OBSERVABILITY_RETENTION_DAYS=14

